# syntax=docker/dockerfile:1.7

# Customer-email ingest worker.
#
# Unlike the warranty and FieldEZ workers this drives no browser — it is IMAP + SMTP +
# Postgres only — so it builds on a plain slim Node image instead of the ~1.5GB Playwright
# base. Same shape as the other workers otherwise: its own process, its own container, so a
# mailbox outage or a hung IMAP socket can never take the API down.
ARG NODE_VERSION=22-bookworm-slim
ARG PNPM_VERSION=9.15.0

FROM node:${NODE_VERSION}

ARG PNPM_VERSION
# NODE_ENV is deliberately NOT production here: pnpm would skip devDependencies
# (typescript/tsc) and the build below would fail.
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH"

WORKDIR /app

# Tesseract reads the text off a payment screenshot, which is how a quotation settles
# itself when the customer sends the receipt and writes nothing — the common case.
#
# The BINARY, not the JavaScript build: that one ships a WASM engine and downloads its
# language data at runtime, and both cost memory in a worker that has been OOM-killed once
# already. This runs in its own process and takes its memory with it when it exits.
# eng only; a UPI receipt is in English whatever the phone's language is set to.
RUN apt-get update     && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng     && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@${PNPM_VERSION}

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY backend/package.json backend/package.json
COPY shared/package.json shared/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

COPY shared shared
COPY backend backend

RUN pnpm --filter @opencall/shared build \
    && pnpm --filter @opencall/api build

# Drop privileges — the worker needs no write access to anything on disk.
USER node

CMD ["node", "backend/dist/worker/mailWorker.js"]

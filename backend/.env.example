# Copy to backend/.env for local pnpm development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://opencall:opencall@localhost:5432/opencall
# Connections the API may hold at once (default 20). This bounds the blast radius of a
# slow endpoint, not throughput: report generation holds one connection for its whole
# transaction, so too small a pool turns one slow report into 500s across every other
# page. Keep it under the server max_connections once the workers have taken theirs.
# PG_POOL_MAX=20
# gzip level for API responses (default 2). Compression is synchronous CPU on the same
# thread that serves every other request, and the report payload is large: level 6 cost
# 267ms per report against level 2s 120ms, for 140KB. Raise only if bandwidth, not CPU,
# is the constraint.
# COMPRESSION_LEVEL=2
JWT_ACCESS_SECRET=dev-jwt-secret-change-me
# How long a sign-in stays valid, in hours (default 12). Because the app renews
# an in-use session in the background (POST /api/v1/auth/refresh), this acts as
# an IDLE timeout: only a session left untouched this long has to sign in again.
# Was a hard-coded 8h, which expired mid-shift.
JWT_ACCESS_TTL_HOURS=12
UPLOAD_DIR=./storage/uploads
CORS_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECRET=dev-admin-cookie-secret-change-me
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me

# --- Inventory HP Stock sync (cases with a part are pushed into the Inventory app) ---
# LOCAL DEV (default): write directly to the Inventory SQLite file.
INVENTORY_DB_PATH=/absolute/path/to/inventory_web/inventory_backend/db.sqlite3
# PRODUCTION: push via the Inventory HTTP API instead. When INVENTORY_API_URL is set,
# the API path is used and INVENTORY_DB_PATH is ignored. The API user must be an
# admin/super_admin/manager so the sync can look up cases across all regions.
# INVENTORY_API_URL=https://inventoryback.systimus.in/api
# INVENTORY_API_USER=svc-opencall
# INVENTORY_API_PASSWORD=change-me

# Payroll integration (engineer case dispatch + live tracking)
PAYROLL_API_URL=
PAYROLL_API_USER=
PAYROLL_API_PASSWORD=

# --- Geocoding (migration 045) -------------------------------------------
# Gives every work order a coordinate, so Location and Distance can stop being
# pincode-level. "none" is a fully supported default: the pincode-centroid tier
# runs on its own, coverage telemetry fills, and nothing calls a third party.
#
# Report generation NEVER calls a geocoder — the worker does, out of band.
GEOCODE_PROVIDER=none
# GEOCODE_PROVIDER=geoapify   # or: opencage | ola
# GEOAPIFY_API_KEY=
# OPENCAGE_API_KEY=
# OLA_MAPS_API_KEY=
#
# How long a cached geocode may be reused, in days. 0 = never expire.
# Set this to 30 ONLY if Ola's terms require it — check the data-retention
# clause shown at signup. Re-geocoding every distinct address monthly costs a
# few thousand calls against a 500,000/month free tier, so enabling it is cheap.
GEOCODE_CACHE_TTL_DAYS=0
#
# Geoapify and OpenCage both explicitly permit storing results in your own
# database, so with either of them GEOCODE_CACHE_TTL_DAYS stays 0.
# OpenCage's free tier is a HARD 1 request/second — its adapter declares that
# floor itself, so GEOCODE_REQUEST_SPACING_MS cannot accidentally exceed it.
#
# Compare providers before committing (needs the keys, not GEOCODE_PROVIDER):
#   npm run geocode:bakeoff -- 200

# Production runtime variables for the API process.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://opencall:replace-with-password@postgres:5432/opencall
JWT_ACCESS_SECRET=replace-with-32-plus-character-random-secret
# How long a sign-in stays valid, in hours (default 12). Because the app renews
# an in-use session in the background (POST /api/v1/auth/refresh), this acts as
# an IDLE timeout: only a session left untouched this long has to sign in again.
# Was a hard-coded 8h, which expired mid-shift.
JWT_ACCESS_TTL_HOURS=12
UPLOAD_DIR=/app/storage/uploads
CORS_ORIGIN=https://opencall.example.com
ADMIN_COOKIE_SECRET=replace-with-32-plus-character-random-secret
ADMIN_SESSION_SECRET=replace-with-32-plus-character-random-secret

# --- Geocoding (migration 045) -------------------------------------------
# Deploy the worker as its own Dokploy Application (Dockerfile app), like the
# warranty and fieldez workers. The API itself never calls a geocoder.
#
# Phase 1 ships with GEOCODE_PROVIDER=none: every work order gets a coarse
# pincode-centroid coordinate and the address queue fills, with zero third-party
# dependency. Switch to ola once the account and its terms are confirmed.
GEOCODE_PROVIDER=none
# GEOCODE_PROVIDER=geoapify   # or: opencage | ola
# GEOAPIFY_API_KEY=
# OPENCAGE_API_KEY=
# OLA_MAPS_API_KEY=replace-with-ola-maps-key
#
# 0 = cache forever. Set 30 if Ola's data-retention clause requires it.
GEOCODE_CACHE_TTL_DAYS=0

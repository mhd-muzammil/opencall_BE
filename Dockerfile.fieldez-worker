# syntax=docker/dockerfile:1.7

# FieldEZ auto-sync worker. Like the warranty worker, this is a Playwright process
# kept entirely separate from the API image. It logs in to FieldEZ, downloads the
# "Flex WIP Report ASP" as XLSX and POSTs it to the OpenCall API (/uploads +
# /reports/.../generate) on a timer — so the report auto-refreshes with no manual step.
#
# The base image tag MUST track the `playwright` version in backend/package.json
# (1.49.1) — the browsers baked into the image are matched to that client.
ARG PLAYWRIGHT_VERSION=v1.49.1-jammy
ARG PNPM_VERSION=9.15.0

FROM mcr.microsoft.com/playwright:${PLAYWRIGHT_VERSION}

ARG PNPM_VERSION
# NODE_ENV is deliberately NOT set to production here: pnpm would then skip
# devDependencies (typescript/tsc) and the build below would fail.
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN npm install -g pnpm@${PNPM_VERSION}

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY backend/package.json backend/package.json
COPY shared/package.json shared/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

COPY shared shared
COPY backend backend

RUN pnpm --filter @opencall/shared build \
    && pnpm --filter @opencall/api build

# The warm browser profile lives on a mounted volume so the FieldEZ session
# survives restarts (fewer logins).
ENV FIELDEZ_PROFILE_DIR=/data/fieldez-profile
RUN mkdir -p /data/fieldez-profile \
    && chown -R pwuser:pwuser /data /app

USER pwuser

CMD ["node", "backend/dist/worker/fieldezSyncWorker.js"]

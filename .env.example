# Docker Compose reads this file when copied to .env in the repo root.
POSTGRES_DB=opencall
POSTGRES_USER=opencall
POSTGRES_PASSWORD=opencall_local_password

# Local-only API runtime secrets. Replace for any shared environment.
JWT_ACCESS_SECRET=local-dev-jwt-secret-0000000000000000
# How long a sign-in stays valid, in hours (default 12). Because the app renews
# an in-use session in the background (POST /api/v1/auth/refresh), this acts as
# an IDLE timeout: only a session left untouched this long has to sign in again.
# Was a hard-coded 8h, which expired mid-shift.
JWT_ACCESS_TTL_HOURS=12
ADMIN_COOKIE_SECRET=local-dev-admin-cookie-secret-0000000000
ADMIN_SESSION_SECRET=local-dev-admin-session-secret-000000000

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Local published API port for docker compose.
API_PORT=4000

# Optional API reverse proxy settings for docker-compose.proxy.yml.
API_DOMAIN=api.opencall.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
MAX_UPLOAD_SIZE=80MB

# Optional container resource limit overrides.
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0
API_MEM_LIMIT=1536m
API_CPUS=1.5
CADDY_MEM_LIMIT=256m
CADDY_CPUS=0.5

# Business-day timezone. Every date the app derives from "now" is an IST calendar day;
# on UTC anything before 05:30 IST landed on the previous day.
TZ=Asia/Kolkata

# --- FieldEZ auto-sync worker (COMPOSE_PROFILES=fieldez) ---
# Job 1: Flex WIP Report ASP -> /uploads -> generate. Already deployed.
FIELDEZ_USERNAME=
FIELDEZ_PASSWORD=
FIELDEZ_REPORT_NAME=Flex WIP Report ASP
FIELDEZ_FORMAT=XLSX
FIELDEZ_SYNC_INTERVAL_MS=900000
# Job 2: Flex Closure ASP Report -> /closure-dates/import (mode=merge). Runs in the SAME
# worker process — one browser, one FieldEZ profile lock. Leave the report name BLANK to
# keep the job switched off; setting it is what enables hourly closure sync.
FIELDEZ_CLOSURE_REPORT_NAME=
FIELDEZ_CLOSURE_INTERVAL_MS=900000
FIELDEZ_CLOSURE_DATE_MODE=today
# Pause between two jobs due in the same cycle, so the closure import never lands
# on the API while a report generation is still finishing.
FIELDEZ_JOB_STAGGER_MS=60000
# OpenCall admin login the worker uses to obtain and auto-refresh its upload token.
OPENCALL_API_URL=http://api:4000
OPENCALL_USERNAME=
OPENCALL_PASSWORD=
# Optional: pin uploads to one region (blank = all regions, as a SUPER_ADMIN).
OPENCALL_REGION_ID=

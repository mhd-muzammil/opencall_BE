# syntax=docker/dockerfile:1.7

# Geocoding worker: drains the geocode_cache queue against the configured
# provider (GEOCODE_PROVIDER + its API key) and keeps office->address road
# distances topped up so the Distance column's exact-address tier can render.
#
# JSON over HTTPS + Postgres only — no browser — so it builds on the same plain
# slim image as the mail worker. Its own process, its own container, for the
# same reason as every other worker here: a slow or rate-limited third party
# must never be able to hold an API request handler open.
ARG NODE_VERSION=22-bookworm-slim
ARG PNPM_VERSION=9.15.0

FROM node:${NODE_VERSION}

ARG PNPM_VERSION
# NODE_ENV is deliberately NOT production here: pnpm would skip devDependencies
# (typescript/tsc) and the build below would fail.
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH"

WORKDIR /app

RUN npm install -g pnpm@${PNPM_VERSION}

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY backend/package.json backend/package.json
COPY shared/package.json shared/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

COPY shared shared
COPY backend backend

RUN pnpm --filter @opencall/shared build \
    && pnpm --filter @opencall/api build

# Drop privileges — the worker needs no write access to anything on disk.
USER node

CMD ["node", "backend/dist/worker/geocodingWorker.js"]
